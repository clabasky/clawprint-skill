# Clawprint API Configuration
# Use either a site origin (Convex / app) or an API root ending in /api — not both required.
# CLAWPRINT_SITE_URL=https://your-deployment.convex.site
CLAWPRINT_API_URL=https://clawprintai.com/api
# From POST /api/users: both required on protected routes (X-Public-Key / X-Secret-Key).
CLAWPRINT_PUBLIC_KEY=
CLAWPRINT_SECRET_KEY=
